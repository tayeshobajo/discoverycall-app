{
  "crons": [
    {
      "path": "/api/cron/trial-transitions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/weekly-reports",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/complete-conversations",
      "schedule": "*/10 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/widget/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, X-Embed-Token, X-Session-Id, X-Source-Page"
        }
      ]
    }
  ]
}
